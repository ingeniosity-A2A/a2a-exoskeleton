{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ingeniosity.tech/schemas/skill-firmware-manifest.json",
  "title": "SkillFirmwareManifest",
  "type": "object",
  "required": ["skill_id", "version", "provides", "entry", "hash_sha256"],
  "properties": {
    "skill_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$" },
    "version": { "type": "string" },
    "provides": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "requires": { "type": "array", "items": { "type": "string" } },
    "entry": { "type": "string" },
    "hash_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "authority": { "type": "string", "enum": ["read", "local", "network", "device"] },
    "tests": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
